# WEB 端口
VITE_WEB_PORT=14558
# API 端口
VITE_SERVER_PORT=25884
# API 地址 - 结尾不要加 /
VITE_API_URL=/api/netease

# ===== Railway / Docker 部署相关 =====
# UnblockAPI 服务端口（独立 Node.js 服务，替代桌面端 Fastify 路由）
UNBLOCK_API_PORT=25885
UNBLOCK_API_HOST=127.0.0.1
# 网易云服务端 IP（容器内通过 /etc/hosts 劫持 music.163.com 域名时使用）
NETEASE_SERVER_IP=220.197.30.65
# UnblockNeteaseMusic 使用的音源
# 可选：kugou kuwo bilibili migu qq xiami youtube pyncmd
UNBLOCK_SOURCES=kugou kuwo bodian pyncmd
